# Docker Compose deployment variables.
# Copy to .env, generate fresh values, and never commit the resulting .env.
POSTGRES_USER=shg_app
POSTGRES_DB=shg_saathi
POSTGRES_PASSWORD=
SECRET_KEY=
SHG_SERVICE_KEY=
BACKEND_CORS_ORIGINS=["https://your-frontend.example.com"]

# Optional external provider credentials for the AI service.
# Keep these server-side; never add them to a VITE_* variable.
LLM_PROVIDER=local
LLM_API_KEY=
VISION_PROVIDER=local
VISION_API_KEY=
OCR_PROVIDER=local
OCR_API_KEY=
SPEECH_PROVIDER=local
SPEECH_API_KEY=
TRANSLATION_PROVIDER=local
TRANSLATION_API_KEY=

