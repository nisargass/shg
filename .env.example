# ==============================================================================
# SHG SAATHI ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and adjust variables for your local setup.
# NEVER commit the real .env file with production credentials into git!
# ==============================================================================

PROJECT_NAME="SHG Saathi Backend"
ENV="development"
DEBUG=true

# Database Configuration
# Local SQLite fallback:
DATABASE_URL=sqlite:///./shg_saathi.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/shg_saathi

# Security & JWT Authentication
# Run `openssl rand -hex 32` to generate a production secret key
SECRET_KEY=shg_saathi_super_secure_jwt_secret_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI/ML Microservice Integration
# Set to 'mock' for standalone local dev when the external AI/ML microservice is offline
AI_SERVICE_BASE_URL=mock
# When live AI service is deployed:
# AI_SERVICE_BASE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT_SECONDS=10.0
AI_SERVICE_USE_MOCK_FALLBACK=true

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# CORS Origins (React Frontend dev servers)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

