# SHG Saathi AI Microservice Environment Configuration
APP_NAME=SHG Saathi AI Microservice
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8001

# Security: generate a secret and set the same value in backend/.env
SHG_SERVICE_KEY=development-only-change-this-before-production

# AI / LLM Provider Configuration (e.g. 'local', 'groq', 'openai')
LLM_PROVIDER=local
LLM_API_KEY=
LLM_MODEL=llama-3.1-70b-versatile

# Computer Vision Provider Configuration ('local' or cloud provider)
VISION_PROVIDER=local
VISION_API_KEY=

# Document OCR Engine ('local', 'tesseract')
OCR_PROVIDER=local
OCR_API_KEY=

# Speech-to-Text and Voice Provider ('local', 'whisper')
SPEECH_PROVIDER=local
SPEECH_API_KEY=

# Multilingual Translation Provider ('local', 'cloud')
TRANSLATION_PROVIDER=local
TRANSLATION_API_KEY=

# RAG Knowledge Base and Vector Store
VECTOR_STORE_PATH=./knowledge_base
AI_PROVIDER_TIMEOUT=15.0
MAX_UPLOAD_SIZE_MB=25

