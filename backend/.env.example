# Local development template. For Docker Compose production settings, see ../.env.example.
PROJECT_NAME="SHG Saathi Backend"
ENV="development"
DEBUG=true
ALLOW_PUBLIC_REGISTRATION=true

# Database Configuration (PostgreSQL / SQLite fallback for quick local testing)
# For local Postgres: postgresql://postgres:postgres@localhost:5432/shg_saathi
DATABASE_URL=sqlite:///./shg_saathi.db

# Security & Authentication
SECRET_KEY=development-only-change-this-before-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SHG_SERVICE_KEY=development-only-change-this-before-production

# AI/ML Microservice Integration (Use 'mock' for local development without external AI service)
AI_SERVICE_BASE_URL=mock
AI_SERVICE_TIMEOUT_SECONDS=10.0
AI_SERVICE_USE_MOCK_FALLBACK=true

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
